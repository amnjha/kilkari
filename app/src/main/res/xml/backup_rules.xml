<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. Includes name what is backed up, so every directory the app writes
    has to be listed: scans, the child's photo and the DataStore settings live under files/,
    not in sharedpref.
-->
<full-backup-content>
    <include domain="database" path="kilkari.db" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="documents" />
    <include domain="file" path="photos" />
    <include domain="file" path="datastore" />
</full-backup-content>
