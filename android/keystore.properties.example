# Copy to keystore.properties (gitignored) and fill in to produce a signed release.
# Create the key first:
#   keytool -genkeypair -v -keystore kilkari-upload.jks -alias kilkari \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=kilkari-upload.jks
storePassword=
keyAlias=kilkari
keyPassword=
