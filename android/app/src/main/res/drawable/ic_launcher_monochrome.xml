<!--
  Single-colour silhouette for Android 13+ themed icons, which cannot use the artwork's
  photographic layer. Drawn on the adaptive 108dp canvas, inside the 72dp the mask reveals.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Head -->
    <path
        android:fillColor="#000000"
        android:pathData="M42,62m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0" />
    <!-- Ear -->
    <path
        android:fillColor="#000000"
        android:pathData="M23,65m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />

    <!-- Three sound waves, rising away from the ear -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M63.1,50.4 A12,12 0 0 1 69.6,58.9" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M64.4,45.6 A17,17 0 0 1 76.4,57.6" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M65.7,40.7 A22,22 0 0 1 81.3,56.3" />
</vector>
