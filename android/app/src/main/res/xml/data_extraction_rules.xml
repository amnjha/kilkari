<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. Same set as backup_rules.xml, for cloud backup and phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kilkari.db" />
        <include domain="file" path="documents" />
        <include domain="file" path="photos" />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kilkari.db" />
        <include domain="file" path="documents" />
        <include domain="file" path="photos" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
